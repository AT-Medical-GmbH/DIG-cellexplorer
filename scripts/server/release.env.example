# Cell Explorer – Server-Konfiguration (Kopie als /etc/atmed/cell-explorer.env oder ~/.cell-explorer.env).
# Enthält KEINE Geheimnisse. Alle Pfade sind Vorschläge und vom Betreiber zu bestätigen.
CE_REPO_DIR=/srv/atmed/projekte/cell-explorer/repo.git          # Git-Repository (bare oder normal)
CE_WORK_DIR=/srv/atmed/projekte/cell-explorer/work              # Build-Arbeitsverzeichnisse
CE_RELEASES_DIR=/srv/atmed/projekte/cell-explorer/releases      # archivierte Releases (Rückweg)
CE_ASSET_VAULT=/srv/atmed/projekte/cell-explorer/assets-vault   # geprüfte Medien (models/, nih-previews/)
CE_INSTALL_DIR=/srv/atmed/stacks/wordpress/wordpress/wp-content/atmed-private/cellexplorer
CE_ASSET_TIER=nc                  # cc0 = nur CC0-Modelle; nc = zusätzlich CC BY-NC-SA (Entscheidung 2026-10-31)
CE_BASE_PATH=/cellexplorer/       # muss mit / beginnen und enden
CE_SITE_URL=https://at-medical.de # für verify-site.sh
CE_KEEP_RELEASES=5
